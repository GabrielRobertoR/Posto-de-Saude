@startuml
skinparam classAttributeIconSize 0

class UnidadeSaude {
  - id: int
  - nome: String
  - endereco: String
  - telefone: String
  - horarioFuncionamento: String
}

class Usuario {
  - id: int
  - nome: String
  - email: String
  - senhaHash: String
  - telefone: String
  - ativo: boolean
}

class Morador {
  - id: int
}

class Funcionario {
  - matricula: String
  - cargo: String
}

class Administrador {
  - nivelAcesso: String
}

class Medico {
  - id: int
  - nome: String
  - especialidade: String
}

class DisponibilidadeMedica {
  - id: int
  - data: Date
  - horario: String
  - status: String
  - observacao: String
}

class Medicamento {
  - id: int
  - nome: String
  - descricao: String
}

class EstoqueMedicamento {
  - id: int
  - quantidadeDisponivel: int
  - dataAtualizacao: DateTime
  - status: String
}

class Vacina {
  - id: int
  - nome: String
  - descricao: String
}

class DisponibilidadeVacina {
  - id: int
  - quantidadeDisponivel: int
  - dataAtualizacao: DateTime
  - status: String
}

class Aviso {
  - id: int
  - titulo: String
  - mensagem: String
  - dataPublicacao: DateTime
  - dataValidade: Date
  - status: String
}

class Notificacao {
  - id: int
  - mensagem: String
  - dataEnvio: DateTime
  - status: String
}

Usuario <|-- Morador
Usuario <|-- Funcionario
Funcionario <|-- Administrador

UnidadeSaude "1" -- "0..*" Funcionario : possui
UnidadeSaude "1" -- "0..*" Medico : atende
UnidadeSaude "1" -- "0..*" EstoqueMedicamento : mantem
UnidadeSaude "1" -- "0..*" DisponibilidadeVacina : registra
UnidadeSaude "1" -- "0..*" Aviso : publica

Medico "1" -- "0..*" DisponibilidadeMedica : possui agenda
Medicamento "1" -- "0..*" EstoqueMedicamento : possui registros
Vacina "1" -- "0..*" DisponibilidadeVacina : possui registros

Funcionario "1" -- "0..*" Aviso : publica
Funcionario "1" -- "0..*" EstoqueMedicamento : atualiza
Funcionario "1" -- "0..*" DisponibilidadeVacina : atualiza
Funcionario "1" -- "0..*" DisponibilidadeMedica : atualiza

Morador "1" -- "0..*" Notificacao : recebe
Aviso "0..1" -- "0..*" Notificacao : pode gerar

@enduml
