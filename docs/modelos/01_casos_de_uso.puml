@startuml
left to right direction

actor "Morador/Paciente" as Paciente
actor "Funcionario da UBS" as Funcionario
actor "Administrador do Sistema" as Admin
actor "Servico de Notificacoes" as Notificacao
actor "Sistema Externo de Saude" as SistemaExterno

rectangle "Aplicativo do Postinho de Saude" {
  usecase "Consultar medicos\ndisponiveis no dia" as UC1
  usecase "Consultar vacinas\ndisponiveis" as UC2
  usecase "Consultar medicamentos\ndisponiveis" as UC3
  usecase "Consultar avisos\nda unidade" as UC4
  usecase "Receber notificacoes" as UC5
  usecase "Consultar informacoes\nda unidade" as UC6
  usecase "Atualizar disponibilidade\nde medicos" as UC7
  usecase "Atualizar estoque\nde medicamentos" as UC8
  usecase "Atualizar disponibilidade\nde vacinas" as UC9
  usecase "Publicar avisos" as UC10
  usecase "Gerenciar usuarios\ne permissoes" as UC11
  usecase "Sincronizar informacoes\ncom sistema externo" as UC12
  usecase "Enviar notificacoes" as UC13
}

Paciente --> UC1
Paciente --> UC2
Paciente --> UC3
Paciente --> UC4
Paciente --> UC5
Paciente --> UC6

Funcionario --> UC7
Funcionario --> UC8
Funcionario --> UC9
Funcionario --> UC10

Admin --> UC11
Admin --> UC12

SistemaExterno --> UC12
UC12 ..> UC7 : <<include>>
UC12 ..> UC8 : <<include>>
UC12 ..> UC9 : <<include>>

UC10 ..> UC13 : <<include>>
UC13 --> Notificacao

@enduml
